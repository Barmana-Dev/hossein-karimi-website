{
  "name": "hossein-karimi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd apps/web && next dev -p 3000",
    "dev:api": "cd apps/api && npm run dev",
    "build": "cd apps/web && next build",
    "build:api": "cd apps/api && npm run build",
    "build:prod": "npm run build && npm run build:api",
    "start": "cd apps/web && next start -p 3000",
    "start:api": "cd apps/api && npm run start",
    "lint": "eslint apps/web apps/api/src",
    "test": "tsx --test apps/web/tests/api-helpers.test.mjs && cd apps/api && npm test",
    "typecheck": "tsc --noEmit && cd apps/api && tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^4.7.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shamsi-calendar": "^0.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
