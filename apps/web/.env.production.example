# ===== حالت پروداکشن (Production) =====
# این فایل را به .env.production کپی کنید:
#   cp apps/web/.env.production.example apps/web/.env.production
# سپس: npm run build && npm run start
#
# توجه: مقادیر NEXT_PUBLIC_* هنگام build داخل خروجی قرار می‌گیرند؛
# بنابراین باید پیش از build پروداکشن تنظیم شوند.

# آدرس کامل API روی دامنهٔ واقعی (شامل /api/v1)
NEXT_PUBLIC_API_URL="https://api.hosseinkarimi.com/api/v1"

# آدرس عمومی سایت
NEXT_PUBLIC_SITE_URL="https://hosseinkarimi.com"

# دامنه‌های اضافی تصویر (در صورت استفاده از CDN)
NEXT_PUBLIC_IMAGE_HOSTS=""
