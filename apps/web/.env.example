# ===== حالت توسعه (Development) =====
# این فایل را به .env.development کپی کنید (یا .env.local):
#   cp apps/web/.env.example apps/web/.env.development

# آدرس کامل API (شامل /api/v1)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# آدرس عمومی سایت (برای metadata، robots و sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# دامنه‌های اضافی مجاز برای next/image (اختیاری، با کاما جدا شوند)
NEXT_PUBLIC_IMAGE_HOSTS=""
