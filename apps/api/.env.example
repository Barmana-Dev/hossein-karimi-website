# ===== حالت توسعه (Development) =====
# این فایل را به .env کپی کنید:
#   cp apps/api/.env.example apps/api/.env
# برای تنظیمات مخصوص پروداکشن از .env.production.example استفاده کنید.

# ===== دیتابیس =====
DATABASE_URL="postgresql://postgres:password@localhost:5432/hossein_karimi_db?schema=public"

# ===== سرور =====
PORT=4000

# ===== امنیت =====
# در پروداکشن اجباری و حداقل ۳۲ کاراکتری است
JWT_SECRET="change-me-in-production-min-32-characters"

# دامنه‌های مجاز فرانت‌اند (با کاما جدا شوند)
CORS_ORIGINS="http://localhost:3000"

# ===== محدودیت درخواست‌ها =====
# در دولوپمنت پیش‌فرض ۱۰۰ و در پروداکشن ۵ است
# INQUIRY_RATE_LIMIT_MAX=100
# LOGIN_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_MAX=5000

# ===== رنگ‌آمیزی سخت‌گیرانه‌تر (اختیاری) =====
# TRUST_PROXY=0
# UPLOADS_DIR=uploads
# ENABLE_SWAGGER=true

# ارسال خطاهای سرور به وب‌هوک مانیتورینگ (اختیاری)
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...

# ===== رمز حساب‌های seed (اجباری) =====
# بدون این مقادیر seed اجرا نمی‌شود و هیچ رمز پیش‌فرضی ساخته نمی‌شود
SEED_ADMIN_PASSWORD=""
SEED_EDITOR_PASSWORD=""
SEED_INQUIRY_MANAGER_PASSWORD=""
