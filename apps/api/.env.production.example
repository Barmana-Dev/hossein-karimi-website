# ===== حالت پروداکشن (Production) =====
# این فایل را روی سرور به .env.production کپی کنید:
#   cp apps/api/.env.production.example apps/api/.env.production
# اجرای پروداکشن: npm run start  (در پوشه apps/api پس از npm run build)
#
# نکته: در پروداکشن می‌توانید به‌جای فایل، متغیرها را در خود سرور تنظیم کنید.

# ===== دیتابیس =====
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# ===== سرور =====
PORT=4000

# ===== امنیت =====
# اجباری: حداقل ۳۲ کاراکتر تصادفی
JWT_SECRET=""
# دامنهٔ واقعی سایت (نه localhost)
CORS_ORIGINS="https://hosseinkarimi.com,https://www.hosseinkarimi.com"

# ===== محدودیت درخواست‌ها =====
INQUIRY_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10

# پشت پراکسی/nginx (تعداد پروکسی‌های مورد اعتماد)
TRUST_PROXY=1

# مسیر پایدار ذخیره‌سازی فایل‌های آپلودی
# UPLOADS_DIR=/var/lib/hossein-karimi/uploads

# مستندات API در پروداکشن به‌صورت پیش‌فرض خاموش است
# ENABLE_SWAGGER=true

# ===== رمز حساب‌های seed =====
# در پروداکشن seed اجرا نمی‌شود؛ این مقادیر فقط برای ساخت اولیهٔ حساب‌ها لازم است
# و باید بلافاصله پس از ساخت حساب‌ها از فایل حذف شوند.
SEED_ADMIN_PASSWORD=""
SEED_EDITOR_PASSWORD=""
SEED_INQUIRY_MANAGER_PASSWORD=""
API_RATE_LIMIT_MAX=600

# وب‌هوک خطا برای مانیتورینگ (اختیاری ولی توصیه‌شده)
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...
